    H["Human owner<br/>dispatch.py sends ONE message<br/>mentioning @coordinator only"]:::human
    R["Band room at app.band.ai<br/>addressed messages, tool-call and usage events<br/>Download full session = room.json"]:::band

    subgraph VM["Linux VM on Oracle Cloud, 4 vCPU / 5.8 GiB - no Band Desktop, no GPU, no human"]
        direction TB
        C["coordinator - Claude Code, claude-sonnet-5-5<br/>seat.py via band-sdk ClaudeSDKAdapter<br/>scope, complete handoffs, acceptance"]:::seat
