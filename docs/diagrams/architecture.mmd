    H -- "1 dispatch" --> R
    R <-- "WebSocket per seat, only messages that mention it" --> C
    R <--> I
    R <--> V
    C -- "handoff: full task + full spec" --> I
    C -- "review handoff with the exact hash" --> V
    V -- "ACCEPT or REJECT with evidence" --> C
    I -- "commits" --> G
    I -- "docker build, host-mode run" --> D
    V -- "isolated run on the exact revision" --> D
    D -. "builds from" .-> G
    R -- "Download full session" --> O
    G -- "stage folders" --> O
    C -- "stage reports; the owner never replies" --> R
